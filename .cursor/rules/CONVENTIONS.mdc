## Component Patterns

### Basic structure

```typescript
// features/users/components/user-card.tsx
import { memo } from 'react';
import { View, Pressable } from 'react-native';
import { Card, CardContent } from '@/components/ui/card';
import { Avatar, AvatarImage, AvatarFallback } from '@/components/ui/avatar';
import { Text } from '@/components/ui/text';
import { Button } from '@/components/ui/button';
import type { Id } from '@/convex/_generated/dataModel';

// ─────────────────────────────────────────────────────────────
// TYPES
// ─────────────────────────────────────────────────────────────

interface UserCardProps {
  user: {
    _id: Id<'users'>;
    displayName: string;
    email?: string;
    avatarUrl?: string;
  };
  onPress?: (userId: Id<'users'>) => void;
}

// ─────────────────────────────────────────────────────────────
// COMPONENT
// ─────────────────────────────────────────────────────────────

function UserCardComponent({ user, onPress }: UserCardProps) {
  function handlePress() {
    onPress?.(user._id);
  }

  return (
    <Pressable onPress={handlePress}>
      <Card>
        <CardContent className="flex-row items-center gap-3 p-4">
          <Avatar>
            <AvatarImage source={{ uri: user.avatarUrl }} />
            <AvatarFallback>
              <Text>{user.displayName[0]?.toUpperCase()}</Text>
            </AvatarFallback>
          </Avatar>
          <View className="flex-1">
            <Text className="font-semibold">{user.displayName}</Text>
            {user.email && (
              <Text className="text-sm text-muted-foreground">{user.email}</Text>
            )}
          </View>
        </CardContent>
      </Card>
    </Pressable>
  );
}

// ─────────────────────────────────────────────────────────────
// EXPORT
// ─────────────────────────────────────────────────────────────

export const UserCard = memo(UserCardComponent);
```

### Loading states with Convex

```typescript
import { useQuery } from 'convex/react';
import { api } from '@/convex/_generated/api';
import { FlashList } from '@shopify/flash-list';
import { View } from 'react-native';
import { Text } from '@/components/ui/text';

function UserList() {
  const users = useQuery(api.users.queries.list);

  // undefined = loading
  if (users === undefined) {
    return (
      <View className="flex-1 items-center justify-center">
        <Text className="text-muted-foreground">Loading...</Text>
      </View>
    );
  }

  // Empty state
  if (users.length === 0) {
    return (
      <View className="flex-1 items-center justify-center">
        <Text className="text-muted-foreground">No users found</Text>
      </View>
    );
  }

  return (
    <FlashList
      data={users}
      renderItem={({ item }) => <UserCard user={item} />}
      keyExtractor={item => item._id}
      estimatedItemSize={80}
    />
  );
}
```

