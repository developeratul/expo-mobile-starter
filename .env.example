# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-id # team: your-team, project: your-project

# Public Convex URL for client-side queries
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Public Clerk publishable key for client-side authentication
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-side secrets (used by Convex functions)
# Get this from Clerk Dashboard → Webhooks → Your endpoint → Signing Secret
# Also set this in Convex Dashboard → Settings → Environment Variables for production
CLERK_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Clerk Frontend API URL for Convex auth integration
# Get this from Clerk Dashboard → Configure → JWT Templates → Convex template → Issuer URL
# Format: https://your-clerk-instance.clerk.accounts.dev
CLERK_FRONTEND_API_URL=https://your-clerk-instance.clerk.accounts.dev
