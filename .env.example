# Copy to `.env.local` (see README). Gitignored; this file is the template only.
# Variables validated in `env.js` are marked (required).

# Required — local | staging | production
APP_ENV=local

# Required — from `pnpm convex:dev` or Convex dashboard
CONVEX_DEPLOYMENT=dev:your-deployment-id # team: your-team, project: your-project

# Required — public Convex URL for the app
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Required — Clerk Dashboard → API Keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Convex (Dashboard → Environment Variables; same names in `.env.local` for dev)
# Webhook signing secret — Clerk → Webhooks → your endpoint
CLERK_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# JWT issuer — Clerk → JWT Templates → Convex → Issuer URL
CLERK_FRONTEND_API_URL=https://your-clerk-instance.clerk.accounts.dev
